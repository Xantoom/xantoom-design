{
	"$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
	"$description": "Vixely: electric blue to violet, precise and dense like an editor.",
	"color": {
		"$type": "color",
		"brand": {
			"1": {
				"$value": {
					"colorSpace": "srgb",
					"components": [
						0.1843,
						0.4196,
						1
					],
					"hex": "#2f6bff"
				}
			},
			"2": {
				"$value": {
					"colorSpace": "srgb",
					"components": [
						0.3529,
						0.302,
						1
					],
					"hex": "#5a4dff"
				}
			},
			"3": {
				"$value": {
					"colorSpace": "srgb",
					"components": [
						0.6078,
						0.302,
						1
					],
					"hex": "#9b4dff"
				}
			},
			"$description": "The logo gradient (decorative: never under text)."
		},
		"fill": {
			"1": {
				"$value": {
					"colorSpace": "srgb",
					"components": [
						0.1686,
						0.3843,
						0.9412
					],
					"hex": "#2b62f0"
				}
			},
			"2": {
				"$value": {
					"colorSpace": "srgb",
					"components": [
						0.3529,
						0.302,
						1
					],
					"hex": "#5a4dff"
				}
			},
			"3": {
				"$value": {
					"colorSpace": "srgb",
					"components": [
						0.5412,
						0.2706,
						0.9608
					],
					"hex": "#8a45f5"
				}
			},
			"$description": "The accent fill gradient for buttons, checked controls, bars. on-fill reads on every stop."
		},
		"on-fill": {
			"$value": {
				"colorSpace": "srgb",
				"components": [
					1,
					1,
					1
				],
				"hex": "#ffffff"
			}
		},
		"accent": {
			"$value": {
				"colorSpace": "srgb",
				"components": [
					0.2392,
					0.3098,
					0.902
				],
				"hex": "#3d4fe6"
			},
			"$extensions": {
				"app.xantoom.dark": {
					"colorSpace": "srgb",
					"components": [
						0.6392,
						0.6627,
						1
					],
					"hex": "#a3a9ff"
				}
			},
			"$description": "Accent text, links, focus rings, thin marks: 4.5:1 on every surface."
		}
	},
	"shape": {
		"$type": "number",
		"radius": {
			"$value": 0.8,
			"$description": "Multiplies every radius."
		},
		"density": {
			"$value": 0.9,
			"$description": "Multiplies every space."
		}
	}
}
