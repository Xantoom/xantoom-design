{
	"compilerOptions": {
		"target": "es2024",
		"module": "preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"lib": ["dom", "dom.iterable", "es2024"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": ["src/react"]
}
