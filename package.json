{
	"name": "xantoom-design",
	"version": "0.6.1",
	"description": "The Xantoom design system: tokens, pure-CSS components, motion and an agent skill, one theme per app.",
	"license": "MIT",
	"author": "Xantoom",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Xantoom/xantoom-design.git"
	},
	"type": "module",
	"files": [
		"dist",
		"src",
		"tokens",
		"brand",
		"skills",
		"scripts/cli.ts",
		"scripts/tokens.ts",
		"scripts/contrast.ts",
		"scripts/migrate.ts"
	],
	"exports": {
		".": "./dist/xantoom.css",
		"./css": "./dist/xantoom.css",
		"./foundation": "./dist/foundation.css",
		"./components/*": "./dist/components/*",
		"./themes/*": "./dist/themes/*",
		"./js": {
			"types": "./src/xantoom.d.ts",
			"default": "./dist/xantoom.js"
		},
		"./extras.js": {
			"types": "./src/extras.d.ts",
			"default": "./dist/extras.js"
		},
		"./theme.js": {
			"types": "./src/theme.d.ts",
			"default": "./dist/theme.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"default": "./dist/react.js"
		},
		"./brand": {
			"types": "./src/brand.d.ts",
			"default": "./dist/brand.js"
		},
		"./theme-head.js": "./dist/theme-head.js",
		"./tailwind.css": "./src/tailwind.css",
		"./tokens/*": "./tokens/*",
		"./src/*": "./src/*",
		"./brand/*": "./brand/*"
	},
	"bin": {
		"xantoom-design": "./scripts/cli.ts"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"test": "bun test",
		"lint": "oxlint scripts src test && tsc -p tsconfig.json --noEmit",
		"check": "bun run build && bun run lint && bun test && git diff --exit-code -- dist src/tokens.css src/brand-data.js",
		"demo": "bun demo/serve.ts"
	},
	"devDependencies": {
		"@types/bun": "1.4.5",
		"@types/react": "19.3.3",
		"@types/react-dom": "19.3.0",
		"lightningcss": "1.33.0",
		"oxlint": "1.95.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"react": ">=19.2"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
